    "origin": "Original diagnostic programs and pin schedules, checked against the pinned NMOS transistor netlist; no emulator implementation or upstream test vectors used.",
    "reproduce": "node verify-cycle-fixture.js irq-rdy-cycles.json /path/to/pinned-public-source-files"
  },
  "conventions": {
    "cycles": "Physical Phi2 bus cycles; opcode fetch of program[0] is cycle 0. Pin levels are established in preceding Phi1. Stalls do not stop cycle numbering.",
    "irqAssertedCycles": "IRQ pin is low throughout each listed cycle, high in all other cycles, including before cycle 0.",
    "readHold": "RDY low for startCycle through startCycle+length-1 inclusive; high on cycle startCycle+length, which completes the held read. length counts rejected attempts, not total attempts.",
    "firstFollowingFetch": "First distinct SYNC fetch after the fetch of program[0]; repeats of a held fetch are not new fetches. cycle is its first attempt, completionCycle its completing attempt.",
    "irq": "True means the fetch is substituted with hardware interrupt BRK, not that its bus address is the handler. Confirm by IR=00 after completion, three stack writes with B clear, and IRQ-vector reads.",
    "iAfterCycle": "Array indexed by physical cycle. I sampled on immediately following Phi1, after that Phi2's poll. Suitable for architectural post-tick assertions only when a tick includes these trailing Phi1 effects.",
    "initialI": "I before cycle 0. Default initial IRQ synchronizer and accepted IRQ are clear.",
    "integers": "All program bytes, addresses, cycles, and I values are ordinary JSON integers."
  },
  "defaults": {
    "programAddress": 768,
    "memoryFill": 234,
    "initialI": 0,
    "initialZ": 0,
    "initialA": 1,
    "initialX": 254,
    "initialS": 254,
    "memory": [{"address": 16384, "bytes": [66]}, {"address": 511, "bytes": [32]}],
    "irqVector": 32768,
    "handler": [76, 0, 128],
    "nmiAsserted": false,
    "resetAsserted": false
  },
