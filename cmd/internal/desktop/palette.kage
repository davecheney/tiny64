//kage:unit pixels

package main

// Palette is the C64's sixteen colours. The frame buffer holds indices into
// it rather than whole pixels, so expanding an index into a colour is the
// last thing that happens to a pixel: here, on the GPU.
var Palette [16]vec4

// Fragment resolves one screen pixel. Four horizontally adjacent palette
// indices are packed into the RGBA channels of a single texel of the source
// image, so each fragment picks its own lane out of the texel covering it
// and looks that index up.
func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	pos := dstPos.xy - imageDstOrigin()
	texel := floor(pos.x / 4)
	packed := imageSrc0UnsafeAt(imageSrc0Origin() + vec2(texel+0.5, pos.y))

	lane := floor(pos.x) - texel*4
	index := packed.r
	if lane > 2.5 {
		index = packed.a
	} else if lane > 1.5 {
		index = packed.b
	} else if lane > 0.5 {
		index = packed.g
	}

	// The index arrives as a byte scaled into 0..1; rounding rather than
	// truncating keeps it exact whatever the sampler hands back.
	return Palette[int(index*255.0+0.5)]
}
